      "observation": "release:check is node scripts/release-check.js",
      "whyItMatters": "Release work may have a project-specific workflow."
    },
    {
      "id": "ev-existing-skill",
      "fact": "A user-authored canonical release Skill already exists.",
      "sourcePath": ".agents/skills/release/SKILL.md",
      "sourceLocation": "frontmatter and body",
      "observation": "the release Skill requests exact preservation of its workflow",
      "whyItMatters": "Existing Skill intent takes precedence over regeneration."
    }
  ],
  "expected": {
    "facts": [
      {"id": "fact-release-script", "value": "node scripts/release-check.js", "status": "confirmed", "evidenceIds": ["ev-release-script"]},
      {"id": "fact-existing-skill", "value": "release", "status": "confirmed", "evidenceIds": ["ev-existing-skill"]}
