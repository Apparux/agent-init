    ],
    "skillDecisions": [
      {"name": "release", "action": "KEEP", "reason": "The existing Skill is user-authored and evidence is insufficient for a safe merge."}
    ],
    "allowedActions": [
      {"action": "KEEP", "target": ".agents/skills/release/SKILL.md"},
      {"action": "KEEP", "target": ".claude/skills/release"}
    ],
    "forbiddenPaths": ["package.json", ".agents/skills/release/SKILL.md", ".claude/skills/release", "scripts/"],
    "preservation": [
      {"path": ".agents/skills/release/SKILL.md", "mode": "exact"},
      {"path": ".claude/skills/release", "mode": "exact"}
    ],
    "secondRun": "NO_WRITE_ACTIONS",
    "detection": {
